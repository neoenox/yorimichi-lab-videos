  {
   "key": "kaishaku",
   "title": "なぜ勝てたのか、いくつもの見方",
   "chapter_title": "なぜ勝てたのか：いくつもの見方",
   "scene": [
    {
     "t": "anim",
     "name": "pop_bgimg",
     "img": "war_council",
     "at": 0,

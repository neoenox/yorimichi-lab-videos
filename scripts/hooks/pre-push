#!/bin/sh
# 素材（画像・動画・音声・PDF・原典資料）を含む push を中止するフック。
#
# 導入:
#     python scripts/install_git_hooks.py
# 回避（テキストだけを main に反映したいとき）:
#     python scripts/main_push_textonly.py --pr
#
# 動画素材は 1GB を超えて push が失敗するため、リモートにはテキストだけを置く。
MEDIA_RE='\.(png|jpg|jpeg|gif|webp|bmp|tif|tiff|pdf|zip|npy|npz|mp4|mov|mkv|webm|avi|wav|mp3|m4a|aac|flac|glb|fbx|blend|blend1)$'
ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # ブランチ削除は対象外
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # 新規ブランチ: main との分岐点を基準にする
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
        if [ -z "$base" ]; then
            base=$(git hash-object -t tree /dev/null)
        fi
    else
        base=$remote_sha
    fi

    # 削除（--diff-filter=d で除外）は許可し、追加・変更だけを見る
    bad=$(git diff --name-only --no-renames --diff-filter=d "$base" "$local_sha" 2>/dev/null | grep -Ei "$MEDIA_RE")
    if [ -n "$bad" ]; then
        count=$(printf '%s\n' "$bad" | wc -l | tr -d ' ')
        printf '\n' >&2
        printf '✖ 素材ファイルを含む push を中止しました（%s 件）: %s\n' "$count" "$local_ref" >&2
        printf '%s\n' "$bad" | head -n 20 | sed 's/^/    /' >&2
        if [ "$count" -gt 20 ]; then
            printf '    ... 他 %s 件\n' "$((count - 20))" >&2
        fi
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    printf '\n' >&2
    printf '  リモートにはテキストだけを置きます（.gitignore の方針）。\n' >&2
    printf '  テキストのみ反映する場合: python scripts/main_push_textonly.py --pr\n' >&2
    printf '  素材込みでどうしても push する場合: git push --no-verify ...\n' >&2
fi

exit "$status"
